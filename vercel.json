{
  "version": 2,
  "rewrites": [
    { "source": "/", "destination": "/api/router?path=/" },
    { "source": "/api/search-db", "destination": "/api/search-db" },
    { "source": "/static/css/style.css", "destination": "/api/router?path=/static/css/style.css" },
    { "source": "/robots.txt", "destination": "/api/router?path=/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/api/router?path=/sitemap.xml" },
    { "source": "/((?!api/|static/|_next/|favicon.ico).*\\.html)", "destination": "/api/router?path=/$1" },
    { "source": "/((?!api/|static/|_next/|favicon.ico).*\\.txt)", "destination": "/api/router?path=/$1" },
    { "source": "/category/((?!api/|static/|_next/|favicon.ico).*)", "destination": "/api/router?path=/category/$1" }
  ]
}
